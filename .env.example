# Service account for the target GCS bucket.
# GCP_PRIVATE_KEY keeps newlines escaped as \n, same as the sibling services.
GCP_BUCKET=""
GCP_PROJECT_ID=""
GCP_EMAIL=""
GCP_CLIENT_ID=""
GCP_PRIVATE_KEY_ID=""
GCP_PRIVATE_KEY=""

# Every object key is forced under this prefix; a caller cannot escape it.
UPLOAD_ROOT_PREFIX="uploads"

# Gate for the UI. Required to mint signed URLs.
UPLOAD_ACCESS_CODE=""
# openssl rand -hex 32
SESSION_SECRET=""
